#:import dp kivy.metrics.dp
#:import TranslationButton app.widgets.translation_button.TranslationButton
#:import TranslationLabel app.widgets.translation_label.TranslationLabel
#:import SafeAreaBoxLayout app.widgets.safe_area.SafeAreaBoxLayout

<SettingsScreen>:
    SafeAreaBoxLayout:
        orientation: "vertical"
        spacing: dp(10)
        padding: dp(5)

        # Верхняя панель
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)
            padding: dp(5)

            TranslationLabel:
                translation_key: "settings"
                font_size: "22sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            Widget:

            TranslationButton:
                translation_key: "back"
                size_hint_x: None
                width: dp(90)
                on_release: root.go_back()

        TranslationLabel:
            translation_key: "mail_provider"
            size_hint_y: None
            height: dp(30)
            halign: "left"
            text_size: self.size

        Spinner:
            id: provider_spinner
            text: root.selected_server
            values: ["Mail.ru", "Gmail", "Yandex", "Outlook"]
            size_hint_y: None
            height: dp(45)

        TranslationLabel:
            translation_key: "email"
            size_hint_y: None
            height: dp(30)
            halign: "left"
            text_size: self.size

        TextInput:
            id: email_input
            multiline: False
            size_hint_y: None
            height: dp(45)

        TranslationLabel:
            translation_key: "password"
            size_hint_y: None
            height: dp(30)
            halign: "left"
            text_size: self.size

        TextInput:
            id: password_input
            password: True
            multiline: False
            size_hint_y: None
            height: dp(45)

        TranslationLabel:
            translation_key: "password_hint"
            size_hint_y: None
            height: dp(70)
            color: 0.5, 0.5, 0.5, 1
            font_size: "13sp"
            halign: "left"
            text_size: self.size

        Widget:

        # Сообщение об успехе или ошибке
        Label:
            id: status_label
            text: ""
            size_hint_y: None
            height: dp(45)
            color: 0.9, 0.2, 0.2, 1
            halign: "center"
            valign: "middle"
            text_size: self.size

        TranslationButton:
            id: save_button
            translation_key: "save"
            size_hint_y: None
            height: dp(50)
            on_release: root.save()