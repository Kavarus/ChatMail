<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: "15dp"
        spacing: "10dp"

        Label:
            text: "Настройки"
            size_hint_y: None
            height: "40dp"
            font_size: "22sp"

        Label:
            text: "Почтовый сервер"
            size_hint_y: None
            height: "30dp"
            halign: "left"
            text_size: self.size

        Spinner:
            id: provider_spinner
            text: root.selected_server
            values: ["Mail.ru", "Gmail", "Yandex", "Outlook"]
            size_hint_y: None
            height: "45dp"

        Label:
            text: "Пользователь"
            size_hint_y: None
            height: "30dp"
            halign: "left"
            text_size: self.size

        TextInput:
            id: email_input
            multiline: False
            size_hint_y: None
            height: "45dp"

        Label:
            text: "Пароль"
            size_hint_y: None
            height: "30dp"
            halign: "left"
            text_size: self.size

        TextInput:
            id: password_input
            password: True
            multiline: False
            size_hint_y: None
            height: "45dp"

        Label:
            text: "Это специальный пароль для приложений"
            size_hint_y: None
            height: "35dp"
            color: 0.5, 0.5, 0.5, 1
            font_size: "13sp"
            halign: "left"
            text_size: self.size

        Widget:

        Button:
            text: "Сохранить"
            size_hint_y: None
            height: "50dp"
            on_release: root.save()

        Label:
            id: status_label
            text: ""