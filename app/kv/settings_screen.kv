#:import dp kivy.metrics.dp

<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(15)
        spacing: dp(10)

        # Верхняя панель
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(10)

            Label:
                text: "Настройки"
                font_size: "22sp"
                halign: "left"
                valign: "middle"
                text_size: self.size

            Widget:

            Button:
                text: "Назад"
                size_hint_x: None
                width: dp(90)
                on_release: root.go_back()

        Label:
            text: "Почтовый сервер"
            size_hint_y: None
            height: dp(30)
            halign: "left"
            text_size: self.size

        Spinner:
            id: provider_spinner
            text: root.selected_server
            values: ["Mail.ru", "Gmail", "Yandex", "Outlook"]
            size_hint_y: None
            height: dp(45)

        Label:
            text: "Пользователь"
            size_hint_y: None
            height: dp(30)
            halign: "left"
            text_size: self.size

        TextInput:
            id: email_input
            multiline: False
            size_hint_y: None
            height: dp(45)

        Label:
            text: "Пароль"
            size_hint_y: None
            height: dp(30)
            halign: "left"
            text_size: self.size

        TextInput:
            id: password_input
            password: True
            multiline: False
            size_hint_y: None
            height: dp(45)

        Label:
            text: "Для подключения используется пароль приложения, который нужно заранее создать в почтовом сервисе."
            size_hint_y: None
            height: dp(70)
            color: 0.5, 0.5, 0.5, 1
            font_size: "13sp"
            halign: "left"
            text_size: self.size

        Widget:

        # Сообщение об успехе или ошибке
        Label:
            id: status_label
            text: ""
            size_hint_y: None
            height: dp(45)
            color: 0.9, 0.2, 0.2, 1
            halign: "center"
            valign: "middle"
            text_size: self.size

        Button:
            id: save_button
            text: "Сохранить"
            size_hint_y: None
            height: dp(50)
            on_release: root.save()