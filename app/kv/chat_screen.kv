#:import dp kivy.metrics.dp
#:import TranslationLabel app.widgets.translation_label.TranslationLabel
#:import TranslationButton app.widgets.translation_button.TranslationButton
#:import TranslationTextInput app.widgets.translation_text_input.TranslationTextInput
#:import SafeAreaBoxLayout app.widgets.safe_area.SafeAreaBoxLayout

<ChatScreen>:
    SafeAreaBoxLayout:
        orientation: "vertical"
        size_hint: 1, 1

        # Верхняя панель
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: dp(5)
            spacing: dp(5)

            TranslationButton:
                translation_key: "back"
                size_hint_x: None
                width: dp(80)
                on_release: root.go_back()

            Label:
                text: root.contact_name
                halign: "center"
                valign: "middle"
                text_size: self.size
                font_size: "18sp"

            Widget:
                size_hint_x: None
                width: dp(80)

        # Сообщения
        ScrollView:
            id: messages_scroll
            do_scroll_x: False

            GridLayout:
                id: messages_list
                cols: 1
                spacing: dp(5)
                padding: dp(10)
                size_hint_y: None
                height: self.minimum_height

        Label:
            id: status_label
            text: ""
            size_hint_y: None
            height: dp(25)
            color: 0.3, 0.3, 0.3, 1

        # Нижняя панель
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            padding: dp(5)
            spacing: dp(5)

            TranslationTextInput:
                id: message_input
                multiline: False
                hint_translation_key: "message_hint"
                input_type: "text"
                on_text_validate: root.send_message()

            TranslationButton:
                translation_key: "send"
                size_hint_x: None
                width: dp(110)
                on_release: root.send_message()