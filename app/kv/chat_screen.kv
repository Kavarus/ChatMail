<ChatScreen>:
    BoxLayout:
        orientation: "vertical"

        # Верхняя панель
        BoxLayout:
            size_hint_y: None
            height: "50dp"
            padding: "5dp"
            spacing: "5dp"

            Button:
                text: "Назад"
                size_hint_x: None
                width: "80dp"
                on_release: root.go_back()

            Label:
                text: root.contact_name
                halign: "center"
                valign: "middle"
                text_size: self.size
                font_size: "18sp"

            Widget:
                size_hint_x: None
                width: "80dp"

        # Сообщения
        ScrollView:
            id: messages_scroll
            do_scroll_x: False

            GridLayout:
                id: messages_list
                cols: 1
                spacing: "5dp"
                padding: "10dp"
                size_hint_y: None
                height: self.minimum_height

        Label:
            id: status_label
            text: ""
            size_hint_y: None
            height: "25dp"
            color: 0.3, 0.3, 0.3, 1

        # Нижняя панель
        BoxLayout:
            size_hint_y: None
            height: "55dp"
            padding: "5dp"
            spacing: "5dp"

            TextInput:
                id: message_input
                multiline: False
                hint_text: "Введите сообщение"
                on_text_validate: root.send_message()

            Button:
                text: "Отправить"
                size_hint_x: None
                width: "110dp"
                on_release: root.send_message()