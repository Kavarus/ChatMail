#:import dp kivy.metrics.dp
#:import TranslationButton app.widgets.translation_button.TranslationButton
#:import TranslationLabel app.widgets.translation_label.TranslationLabel
#:import AppStatusLabel app.widgets.app_status_label.AppStatusLabel
#:import SafeAreaBoxLayout app.widgets.safe_area.SafeAreaBoxLayout

<MainScreen>:
    SafeAreaBoxLayout:
        orientation: "vertical"
        spacing: 0

        # Верхняя строка
        BoxLayout:
            size_hint_y: None
            height: dp(50)
            spacing: dp(5)
            padding: dp(5)

            TranslationButton:
                translation_key: "settings"
                size_hint_x: None
                width: dp(120)
                on_release: root.open_settings()

            Widget:

            TranslationButton:
                translation_key: "add_contact"
                size_hint_x: None
                width: dp(160)
                on_release: root.add_contact()

        TranslationLabel:
            translation_key: "main_title"
            size_hint_y: None
            height: dp(40)
            font_size: "20sp"

        # Список контактов
        ScrollView:
            do_scroll_x: False

            GridLayout:
                id: contacts_list
                cols: 1
                spacing: dp(2)
                padding: dp(5)
                size_hint_y: None
                height: self.minimum_height

        AppStatusLabel:
            id: app_status_label
            size_hint_y: None
            height: dp(38)
            padding: dp(8), dp(4)
            text_size: self.width - dp(16), self.height
            halign: "left"
            valign: "middle"
            font_size: "13sp"
            color: self.status_color