#:import dp kivy.metrics.dp
#:import i18n app.services.i18n.i18n
#:import TranslationLabel app.widgets.translation_label.TranslationLabel
#:import TranslationButton app.widgets.translation_button.TranslationButton
#:import TranslationSpinner app.widgets.translation_spinner.TranslationSpinner
#:import SafeBottomBoxLayout app.widgets.safe_area.SafeAreaBoxLayout

<WelcomeScreen>:
    SafeAreaBoxLayout:
        orientation: "vertical"
        size_hint: 1, 1
        padding: dp(20), dp(12), dp(20), dp(0)
        spacing: dp(12)

        # Фиксированный заголовок
        TranslationLabel:
            translation_key: "welcome_title"
            size_hint_y: None
            height: dp(58)
            font_size: "26sp"
            bold: True
            halign: "center"
            valign: "middle"
            text_size: self.size

        # Прокручиваемая часть
        ScrollView:
            id: welcome_scroll
            do_scroll_x: False
            do_scroll_y: True
            bar_width: dp(4)
            scroll_y: 1

            BoxLayout:
                orientation: "vertical"
                spacing: dp(15)
                padding: 0, dp(5), 0, dp(12)
                size_hint_y: None
                height: self.minimum_height

                TranslationLabel:
                    translation_key: "welcome_text"
                    size_hint_y: None
                    text_size: self.width, None
                    height: self.texture_size[1]
                    halign: "left"
                    valign: "top"

                TranslationLabel:
                    translation_key: "terms_title"
                    font_size: "20sp"
                    bold: True
                    size_hint_y: None
                    height: dp(40)
                    halign: "left"
                    text_size: self.size

                TranslationLabel:
                    translation_key: "terms_text"
                    size_hint_y: None
                    text_size: self.width, None
                    height: self.texture_size[1]
                    halign: "left"
                    valign: "top"

        # Нижняя панель
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: dp(30) + dp(45) + dp(55) + dp(16)
            spacing: dp(6)

            Label:
                text: "Language"
                size_hint_y: None
                italic: True
                color: 0.7, 0.7, 0.7, 1
                height: dp(30)
                halign: "left"
                valign: "middle"
                text_size: self.size

            TranslationSpinner:
                id: language_spinner
                size_hint_y: None
                height: dp(45)
                on_text: root.select_language(self.selected_language)

            TranslationButton:
                translation_key: "accept"
                size_hint_y: None
                background_color: 0.7, 1, 0.7, 1
                height: dp(55)
                on_release: root.accept()